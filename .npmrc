# Build tooling must survive an install made with NODE_ENV=production.
#
# Render sets NODE_ENV=production for the whole service, build step included,
# and npm reads it: `npm install` then omits devDependencies. That silently
# removed `typescript`, `tsc-alias` and the `@types/*` packages from the build
# machine, which broke the build in two ways at once — Next.js only reads
# `tsconfig.json` (and therefore the `@/*` path aliases) when `typescript`
# resolves, and the second half of `npm run build` shells out to `tsc`.
#
# This project's devDependencies are build tools, not test-only extras, so the
# install must always include them. The runtime image still ships only
# `dependencies`; nothing here changes what `npm ci --omit=dev` installs.
include=dev
