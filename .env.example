# ---------------------------------------------------------------------------
# Scribble & Guess backend — copy to `.env.local` and fill in.
# NEVER commit a real secret. `.env.local` is git-ignored.
#
# One file, two deployments. Locally `npm run dev` boots REST and Socket.IO in
# one process (`server.ts`) and every value below applies. In production they
# are split, because Socket.IO cannot run on a serverless host:
#
#   REST      -> Vercel, running `src/app/api` as serverless functions
#   Realtime  -> a persistent Node host, running `socket-server.ts`
#
# The two variable groups below say which side needs what. The values marked
# SHARED must be byte-identical on both, or tokens minted by one will be
# rejected by the other.
# ---------------------------------------------------------------------------

# --- SHARED: set on BOTH deployments ---------------------------------------

# Mongo connection string. Locally the database name is part of the URI; an
# Atlas string ends in /admin (the auth database), so name the real one in
# MONGODB_DB instead. Set, MONGODB_DB always wins over the URI path.
MONGODB_URI=mongodb://localhost:27017/scribbleAndGuess
# MONGODB_DB=SG

# Signing key for the JWTs handed out by /api/auth/guest. The REST deployment
# mints them and the realtime deployment verifies them, so a mismatch shows up
# as every socket handshake failing with AUTH_ERROR.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated allowed browser origins, or * for any. This only gates
# browsers: native Flutter clients send no Origin header at all, so tightening
# it does not lock the mobile app out.
CORS_ORIGIN=*

# Structured logging: error | warn | info | debug
LOG_LEVEL=info

# --- REST deployment (Vercel) ----------------------------------------------

# Where the realtime server lives. The Flutter app is told this address, and
# GET /api/health probes `${SOCKET_URL}/healthz` so it can report the realtime
# state truthfully instead of guessing from whether the variable is set.
#
# Locally this is the same origin as the API, because `server.ts` serves both.
# In production it is the persistent host:
#   SOCKET_URL=https://scribble-and-guess-realtime.onrender.com
SOCKET_URL=http://localhost:3000

# Advertised to clients.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Realtime deployment (Render / Railway / Fly / a container) -------------

# Where this server listens. Most platforms inject PORT; leave it unset there
# and let the platform choose. HOST must be 0.0.0.0 in a container, or the
# platform's health check cannot reach the process.
PORT=3000
HOST=0.0.0.0

NODE_ENV=development
