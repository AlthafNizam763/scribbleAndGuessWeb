# ---------------------------------------------------------------------------
# Scribble & Guess backend — copy to `.env.local` and fill in.
# NEVER commit a real secret. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Mongo connection string. Locally the database name is part of the URI; an
# Atlas string ends in /admin (the auth database), so name the real one in
# MONGODB_DB instead. Set, MONGODB_DB always wins over the URI path.
MONGODB_URI=mongodb://localhost:27017/scribbleAndGuess
# MONGODB_DB=SG

# Signing key for the JWTs handed out by /api/auth/guest.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Where this server listens.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Advertised to clients. The Flutter app overrides these with --dart-define.
NEXT_PUBLIC_API_URL=http://localhost:3000
SOCKET_URL=http://localhost:3000

# Comma-separated allowed origins, or * for any (mobile clients send none).
CORS_ORIGIN=*

# Structured logging: error | warn | info | debug
LOG_LEVEL=info
