# ---------------------------------------------------------------------------
# Scribble & Guess backend — copy to `.env.local` and fill in.
# NEVER commit a real secret. `.env.local` is git-ignored.
#
# `npm run dev` locally and `npm start` in production both boot the same
# process (`server.ts`): Next.js for the REST routes, Socket.IO attached to the
# same Node HTTP server, one port for both.
#
# That needs a host which keeps a process alive — a Render Web Service, or any
# container host. Vercel is not one: it serves each route in `src/app/api` as
# an isolated serverless function, nothing there ever runs `server.ts`, and a
# function cannot hold a websocket open. A Vercel deployment can therefore
# serve REST perfectly well, but its /api/health will always report the socket
# detached, because it is.
#
# Two shapes are supported, and every variable below applies to both:
#
#   1. Everything on Render (preferred). One service, `npm start`.
#   2. REST on Vercel, realtime on Render (`socket-server.ts`, see render.yaml
#      history and the comment in that file). Keep MONGODB_URI and JWT_SECRET
#      byte-identical across the two, or a token minted by one is rejected by
#      the other, and point SOCKET_URL at the realtime service.
# ---------------------------------------------------------------------------

# --- Required on every deployment ------------------------------------------

# Mongo connection string. Locally the database name is part of the URI; an
# Atlas string ends in /admin (the auth database), so name the real one in
# MONGODB_DB instead. Set, MONGODB_DB always wins over the URI path.
MONGODB_URI=mongodb://localhost:27017/scribbleAndGuess
# MONGODB_DB=SG

# Signing key for the JWTs handed out by /api/auth/guest. The REST deployment
# mints them and the realtime deployment verifies them, so a mismatch shows up
# as every socket handshake failing with AUTH_ERROR.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated allowed browser origins, or * for any. This only gates
# browsers: native Flutter clients send no Origin header at all, so tightening
# it does not lock the mobile app out.
CORS_ORIGIN=*

# Structured logging: error | warn | info | debug
LOG_LEVEL=info

# --- Addresses advertised to clients ----------------------------------------

# What the Flutter client should use as SOCKET_URL. When this service serves
# its own socket — which it does under `server.ts` — /api/health answers from
# the live in-process server and never reads this; it is here so the value the
# app is handed is this origin rather than localhost. On Render both are the
# service URL:
#   SOCKET_URL=https://scribble-and-guess-xxxx.onrender.com
#   NEXT_PUBLIC_API_URL=https://scribble-and-guess-xxxx.onrender.com
#
# In the split deployment (shape 2 above) these differ, and SOCKET_URL must
# name the *realtime* host on BOTH services. On the Vercel deployment it is
# not decorative: /api/health has no socket of its own to inspect there, so it
# probes `SOCKET_URL/healthz` and reports whatever that says. Pointing it at
# the Vercel origin makes it probe itself, get a 404 and report the socket
# permanently `down` while the game is working perfectly — a confusing thing
# to debug from, and the reason this is spelled out. The live values are:
#
#   # on Vercel (REST)
#   SOCKET_URL=https://scribbleandguessweb.onrender.com
#   NEXT_PUBLIC_API_URL=https://scribble-and-guess-web.vercel.app
#
#   # on Render (realtime)
#   SOCKET_URL=https://scribbleandguessweb.onrender.com
#   NEXT_PUBLIC_API_URL=https://scribble-and-guess-web.vercel.app
SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Listener ---------------------------------------------------------------

# Render, and every comparable platform, injects PORT and routes to whatever
# it chose. Leave it unset there — a pinned port is a service that never
# passes its health check. HOST must be 0.0.0.0 on any such host, or nothing
# outside the container can reach the process.
PORT=3000
HOST=0.0.0.0

# Local development only. Do NOT copy this line into a deployment's
# environment, and in particular do not bulk-paste this file into Render's
# "Add from .env" box: a deployed service that has NODE_ENV=development in its
# environment breaks `next build`, which fails while prerendering /404 with
# the thoroughly misleading
#   Error: <Html> should not be imported outside of pages/_document
# `npm run build` and `npm start` both pin NODE_ENV=production themselves, so
# a deployment does not need this variable at all. Set it to production there
# only if something else you run depends on reading it.
NODE_ENV=development

# --- Voice chat (WebRTC) -----------------------------------------------------
#
# Voice is guesser-only: the current drawer can neither speak nor hear, and the
# server refuses their signalling with DRAWER_VOICE_DISABLED.
#
# Only signalling (SDP offers, answers, ICE candidates) passes through this
# server. The audio itself flows directly between players' devices, so voice
# costs this process nothing but a few dozen small messages per turn, and no
# audio is ever written to MongoDB.
#
# These values are handed to clients over `s:voice:state` rather than compiled
# into the app, which is what lets a TURN server be introduced or its
# credentials rotated without shipping a new build.

# STUN tells each peer what its public address looks like. Free, and enough on
# its own for the large majority of home and mobile networks. A comma-separated
# list is accepted. Leaving this at the default is a perfectly good production
# setting.
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# TURN relays the audio when a symmetric NAT blocks a direct path. Optional,
# and it is NOT free — every byte of audio passes through it — so it is left
# unset by default. Point it at your own Coturn if you need the fallback:
#
#   WEBRTC_TURN_URL=turn:turn.example.com:3478
#   WEBRTC_TURN_USERNAME=scribble
#   WEBRTC_TURN_CREDENTIAL=<a real secret, never committed>
#
# With no TURN configured, a peer pair that cannot traverse its NAT simply
# fails to connect and the rest of the room's mesh carries on.
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Automatic tournaments
# ---------------------------------------------------------------------------
#
# The server runs its own tournaments. Nobody creates them — not an admin, and
# certainly not a player — so everything below describes what the organiser bot
# will do on its own, and there is no endpoint through which any of it can be
# overridden at runtime.
#
# Every value here is copied onto a tournament when it is created, not read
# live. A tournament already taking registrations therefore keeps the size and
# bot policy it advertised, even if this file changes underneath it.

# How many tournaments exist at once. Three is the product rule.
#
# Each slot holds at most one unfinished tournament, and that is enforced by a
# unique index rather than by a count — so two servers racing to fill the same
# slot produce one tournament, not two.
TOURNAMENT_SLOT_COUNT=3

# The size of the field. `MIN` is what a tournament needs to start at all;
# `MAX` is a ceiling on how many people may join, NOT a target to fill.
TOURNAMENT_MIN_PLAYERS=4
TOURNAMENT_MAX_PLAYERS=16

# The floor on real people.
#
# This is what makes a bot-only tournament impossible. It is checked at the
# moment the bracket would be drawn, so a tournament nobody joined is cancelled
# rather than played by robots for nobody's benefit.
TOURNAMENT_MIN_HUMAN_PLAYERS=1

# AI players, and how many of them may be used to make a short tournament
# viable. Bots fill the shortfall to `MIN_PLAYERS` and never take a seat that
# a person was going to have.
TOURNAMENT_MAX_BOTS=3
TOURNAMENT_ALLOW_BOTS=true

# How hard the bots play: EASY, NORMAL or HARD. Affects guess timing, guess
# accuracy, drawing speed and how much of a drawing gets finished.
TOURNAMENT_BOT_DIFFICULTY=NORMAL

# The two windows, in minutes.
#
# Registration is long enough to notice; check-in is the short "are you still
# here?" that the bracket is actually drawn from. Without check-in, a knockout
# spends its first round handing walkovers to the people who stayed.
TOURNAMENT_REGISTRATION_MINUTES=10
TOURNAMENT_CHECKIN_MINUTES=2

# Whether this process runs the organiser loop itself.
#
# `true` is the single-service deployment: the realtime process ticks every
# fifteen seconds. Set it to `false` when an external cron drives
# `POST /api/internal/tournaments/scheduler` instead.
#
# Both at once is safe — every tick takes the same distributed lock — so a
# migration from one to the other needs no coordination.
TOURNAMENT_SCHEDULER_ENABLED=true

# The shared secret on that endpoint.
#
# It creates tournaments, cancels them, seats AI players and decides matches,
# so an unset secret refuses every call in production. Unset in development it
# allows the call, so the loop can be driven by hand while building.
#
#   curl -X POST https://your-host/api/internal/tournaments/scheduler \
#     -H "x-scheduler-secret: $TOURNAMENT_SCHEDULER_SECRET"
TOURNAMENT_SCHEDULER_SECRET=
