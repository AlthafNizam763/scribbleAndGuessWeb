{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "jsx": "react-jsx",
    "incremental": false
  },
  "include": ["server.ts", "socket-server.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "scripts", "src/app/**"]
}
